---
import AppLayout from "../../layouts/AppLayout.astro";
export const prerender = false;
---

<AppLayout title="Adestramento">
  <div class="training-header">
    <h1 id="plan-name">Adestramento</h1>
    <p id="plan-description"></p>
  </div>

  <div id="training-content">
    <p>Cargando exercicios...</p>
  </div>

  <div class="training-actions">
    <button id="finish-training-btn" class="button button-primary" disabled>
      Finalizar Adestramento
    </button>
    <button id="cancel-training-btn" class="button button-secondary">
      Cancelar
    </button>
  </div>

  <style>
    .training-header {
      text-align: center;
      margin-bottom: var(--spacing-2xl);
    }

    .training-header h1 {
      margin-bottom: var(--spacing-sm);
    }

    .training-header p {
      color: var(--color-text-muted);
    }

    #training-content {
      margin-bottom: var(--spacing-2xl);
    }

    .dia-section {
      background-color: var(--color-bg-card);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      margin-bottom: var(--spacing-xl);
      border: 2px solid var(--color-border);
    }

    .dia-section h2 {
      color: var(--color-primary);
      margin-top: 0;
      margin-bottom: var(--spacing-lg);
    }

    .exercicio-card {
      background-color: var(--color-bg-secondary);
      padding: var(--spacing-lg);
      border-radius: var(--radius-md);
      margin-bottom: var(--spacing-lg);
      border: 1px solid var(--color-border);
    }

    .exercicio-card h3 {
      color: var(--color-text-primary);
      margin-top: 0;
      margin-bottom: var(--spacing-md);
      font-size: var(--font-size-xl);
    }

    .exercicio-info {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      margin-bottom: var(--spacing-lg);
    }

    .series-container {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .serie-row {
      display: grid;
      grid-template-columns: auto 1fr 1fr;
      gap: var(--spacing-md);
      align-items: center;
      padding: var(--spacing-md);
      background-color: var(--color-bg-main);
      border-radius: var(--radius-sm);
    }

    .serie-label {
      font-weight: 600;
      color: var(--color-text-primary);
      min-width: 80px;
    }

    .input-group-inline {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .input-group-inline label {
      font-size: 0.7rem;
      color: var(--color-text-muted);
      font-weight: 600;
      text-transform: uppercase;
    }

    .input-group-inline input {
      padding: var(--spacing-sm) var(--spacing-md);
      background-color: var(--color-bg-input);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-text-primary);
      font-size: var(--font-size-base);
    }

    .training-actions {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      margin-top: var(--spacing-2xl);
    }

    .button-secondary {
      background-color: var(--color-bg-card);
      border: 2px solid var(--color-border);
    }

    .button-secondary:hover {
      background-color: var(--color-bg-secondary);
      border-color: var(--color-primary);
    }

    @media (max-width: 768px) {
      .serie-row {
        grid-template-columns: 1fr;
        gap: var(--spacing-sm);
      }

      .serie-label {
        min-width: auto;
      }

      .training-actions {
        flex-direction: column;
      }

      .training-actions button {
        width: 100%;
      }
    }
  </style>

  <script src="../../scripts/sesion-adestramento.js"></script>
</AppLayout>
