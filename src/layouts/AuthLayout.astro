---
const { title } = Astro.props;
---

<!doctype html>
<html lang="gl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galentreno</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="deco-under" aria-hidden="true">
      <div class="scroll-gallery">
        <div class="scroll-track">
          <img
            fetchpriority="high"
            src="/img/galeria/foto1.webp"
            alt="Imaxe 1"
            loading="eager"
          />
          <img
            fetchpriority="high"
            src="/img/galeria/foto2.webp"
            alt="Imaxe 2"
            loading="eager"
          />
          <img
            fetchpriority="high"
            src="/img/galeria/foto3.webp"
            alt="Imaxe 3"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <main class="auth-shell">
      <h1 class="sr-only">Galentreno</h1>

      <header class="auth-topbar">
        <a href="/" class="brand-link" aria-label="Inicio Galentreno">
          <img src="/img/GALENTRENO.webp" alt="Galentreno Logo" />
        </a>

        <nav class="links-container" aria-label="Redes sociais">
          <a
            class="social-pill"
            href="https://instagram.com/galentreno"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar o noso perfil de Instagram">Instagram</a
          >
          <a
            class="social-pill"
            href="https://galentreno.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Ir á páxina web principal de Galentreno">Web</a
          >
          <a
            class="social-pill"
            href="https://facebook.com/galentreno"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar a nosa páxina de Facebook">Facebook</a
          >
        </nav>
      </header>

      <section class="deco-right auth-card">
        <div class="auth-content">
          <slot />
        </div>
      </section>

      <footer class="auth-footer">
        <p class="div-text-copy">© {new Date().getFullYear()} GALENTRENO</p>
        <div class="text-frase">
          <p>
            "Somos o que facemos repetidamente. A excelencia, daquela, non é un
            acto, senón un hábito." — Aristóteles
          </p>
        </div>
      </footer>
    </main>

    <script>
      import { gsap } from "gsap";

      document.addEventListener("DOMContentLoaded", () => {
        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        const authContent = document.querySelector(".auth-content");
        if (authContent && !prefersReducedMotion) {
          gsap.fromTo(
            authContent,
            { opacity: 0, y: 20, scale: 0.98 },
            { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: "power3.out" }
          );
        }

        const track = document.querySelector(".scroll-track") as HTMLElement;
        if (track) {
          const originalImages = Array.from(track.querySelectorAll("img"));
          originalImages.forEach((img) => {
            const clone = img.cloneNode(true) as HTMLElement;
            track.appendChild(clone);
          });

          const baseSpeed = prefersReducedMotion ? 0.08 : 0.35;
          let scrollAmount = 0;
          let resetPoint = 0;

          const calculateResetPoint = () => {
            if (track.scrollWidth > 0) {
              resetPoint = track.scrollWidth / 2;
            }
          };

          calculateResetPoint();
          window.addEventListener("resize", calculateResetPoint);

          const animateScroll = () => {
            if (resetPoint === 0) calculateResetPoint();
            scrollAmount += baseSpeed;
            if (scrollAmount >= resetPoint) {
              scrollAmount -= resetPoint;
            }
            track.style.transform = `translate3d(-${scrollAmount}px, 0, 0)`;
            requestAnimationFrame(animateScroll);
          };

          requestAnimationFrame(animateScroll);
        }

        const quotes = [
          '"Somos o que facemos repetidamente. A excelencia, daquela, non é un acto, senón un hábito." — Aristóteles',
          '"Unha viaxe de mil millas comeza cun só paso." — Lao-Tse',
          '"Non basta con saber, hai que aplicar. Non basta con querer, hai que facer." — J.W. von Goethe',
          '"A única maneira de descubrir os límites do posible é ir máis alá deles, cara ao imposible." — Arthur C. Clarke',
          '"Non teño talentos especiais. Só son apaixonadamente curioso." — Albert Einstein',
          '"Os únicos límites que tes son os límites que cres." — Wayne Dyer',
          '"Non te conformes con facelo suficientemente ben. Busca sempre facelo mellor." — Michael Jordan',
        ];

        const fraseElement = document.querySelector(
          ".text-frase p"
        ) as HTMLElement;
        let currentQuoteIndex = 0;

        const rotateQuote = () => {
          if (!fraseElement) return;

          if (!prefersReducedMotion) {
            gsap.to(fraseElement, {
              opacity: 0,
              y: 6,
              duration: 0.4,
              ease: "power2.in",
              onComplete: () => {
                currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
                fraseElement.textContent = quotes[currentQuoteIndex];
                gsap.fromTo(
                  fraseElement,
                  { opacity: 0, y: -6 },
                  { opacity: 0.75, y: 0, duration: 0.4, ease: "power2.out" }
                );
              },
            });
          } else {
            currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
            fraseElement.textContent = quotes[currentQuoteIndex];
          }
        };

        setInterval(rotateQuote, 6000);
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: TexGyre;
    src: url("/fonts/texgyreheros-bold.otf") format("opentype");
    font-display: swap;
  }

  :root {
    --auth-primary: #3b82f6;
    --auth-primary-hover: #2563eb;
    --auth-bg: #070b14;
    --auth-surface: rgba(15, 23, 42, 0.82);
    --auth-border: rgba(148, 163, 184, 0.18);
    --auth-text: #f8fafc;
    --auth-muted: #94a3b8;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Plus Jakarta Sans", TexGyre, -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: var(--auth-bg);
    color: var(--auth-text);
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .deco-under {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .deco-under::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 35%, rgba(15, 23, 42, 0.6) 0%, rgba(7, 11, 20, 0.94) 100%),
      linear-gradient(180deg, rgba(7, 11, 20, 0.78) 0%, rgba(7, 11, 20, 0.92) 100%);
    z-index: 1;
  }

  .scroll-gallery {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .scroll-track {
    display: flex;
    height: 100%;
    will-change: transform;
    gap: 1rem;
    padding: 1rem;
  }

  .scroll-track img {
    width: 48vw;
    min-width: 320px;
    height: 100%;
    object-fit: cover;
    filter: saturate(25%) contrast(1.05) brightness(0.7);
    border-radius: 1rem;
  }

  .auth-shell {
    position: relative;
    z-index: 2;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem clamp(1rem, 4vw, 3rem);
  }

  .auth-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-link:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .brand-link img {
    height: clamp(36px, 5vw, 50px);
    width: auto;
    object-fit: contain;
  }

  .links-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--auth-text);
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--auth-border);
    padding: 0.5rem 0.9rem;
    border-radius: 9999px;
    backdrop-filter: blur(10px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .social-pill:hover {
    background: rgba(59, 130, 246, 0.18);
    border-color: rgba(59, 130, 246, 0.55);
    transform: translateY(-1px);
  }

  .deco-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    width: 100%;
    padding: 2rem 0;
  }

  .auth-content {
    width: 100%;
    max-width: 440px;
    background: var(--auth-surface);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--auth-border);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow:
      0 25px 50px -12px rgba(2, 6, 23, 0.85),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  .auth-footer {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding-top: 1rem;
  }

  .div-text-copy {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    color: var(--auth-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .text-frase {
    max-width: 640px;
    text-align: center;
  }

  .text-frase p {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #cbd5e1;
    opacity: 0.75;
  }

  @media (min-width: 968px) {
    .auth-footer {
      flex-direction: row;
    }

    .text-frase {
      text-align: right;
    }
  }

  @media (max-width: 640px) {
    .auth-topbar {
      flex-direction: column;
      align-items: center;
      gap: 0.875rem;
    }

    .scroll-track img {
      width: 85vw;
    }
  }
</style>