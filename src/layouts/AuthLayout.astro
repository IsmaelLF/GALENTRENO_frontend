---
const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galentreno</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <main>
      <div class="deco-left">
        <a href="/"><img src="/img/GALENTRENO.png" alt="Galentreno Logo" /></a>

        <h1 class="h1-split">
          A TÚA PLATAFORMA DE ADESTRAMENTO 100% EN GALEGO
        </h1>
        <div class="div-texts">
          <div class="div-text-1">
            A TÚA PLATAFORMA DE ADESTRAMENTO 100% EN GALEGO
          </div>
          <p class="div-text-copy">Copyright 2025 GALENTRENO</p>
        </div>
      </div>
      <a class="a-ig" href="https://instagram.com/galentreno" target="_blank"
        >INSTAGRAM</a
      >
      <a class="a-fb" href="https://facebook.com/galentreno" target="_blank"
        >FACEBOOK</a
      >
      <a class="a-web" href="https://galentreno.com" target="_blank">(WEB)</a>
      <div class="deco-right auth-card">
        <div class="auth-content">
          <slot />
          <div class="text-frase">
            <p>
              "Somos o que facemos repetidamente. A excelencia, daquela, non é
              un acto, senón un hábito." - Aristóteles
            </p>
          </div>
        </div>
      </div>
      <div class="deco-under">
        <div class="scroll-gallery">
          <div class="scroll-track">
            <img src="/img/galeria/foto1.jpg" alt="Imaxe 1" />
            <img src="/img/galeria/foto2.jpg" alt="Imaxe 2" />
            <img src="/img/galeria/foto3.jpg" alt="Imaxe 3" />
            <img src="/img/galeria/foto1.jpg" alt="Imaxe 1" />
            <img src="/img/galeria/foto2.jpg" alt="Imaxe 2" />
            <img src="/img/galeria/foto3.jpg" alt="Imaxe 3" />
          </div>
        </div>
      </div>
    </main>
  </body>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const cursorDot = document.createElement("div");
      cursorDot.classList.add("custom-cursor-dot");
      document.body.appendChild(cursorDot);

      let mouseX = 0;
      let mouseY = 0;
      const trail: HTMLElement[] = [];
      const maxTrail = 15;

      document.addEventListener("mousemove", (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;

        cursorDot.style.left = mouseX + "px";
        cursorDot.style.top = mouseY + "px";

        const trailDot = document.createElement("div");
        trailDot.classList.add("cursor-trail");
        trailDot.style.left = mouseX + "px";
        trailDot.style.top = mouseY + "px";
        document.body.appendChild(trailDot);

        trail.push(trailDot);

        if (trail.length > maxTrail) {
          const oldDot = trail.shift();
          if (oldDot) oldDot.remove();
        }

        setTimeout(() => {
          trailDot.style.opacity = "0";
          trailDot.style.transform = "translate(-50%, -50%) scale(0)";
        }, 10);
      });

      document.querySelectorAll("a, button").forEach((el) => {
        el.addEventListener("mouseenter", () => {
          cursorDot.classList.add("cursor-hover");
        });
        el.addEventListener("mouseleave", () => {
          cursorDot.classList.remove("cursor-hover");
        });
      });

      const container = document.querySelector(".deco-under") as HTMLElement;
      const track = document.querySelector(".scroll-track") as HTMLElement;

      if (!container || !track) return;

      const baseSpeed = 0.3;
      const fastSpeed = 15;
      const decay = 0.98;

      let currentSpeed = baseSpeed;
      let scrollAmount = 0;
      let resetPoint = 0;

      function calculateResetPoint() {
        if (!track) return;
        const images = track.querySelectorAll("img");
        const totalImages = images.length;

        if (totalImages > 0) {
          resetPoint = track.scrollWidth / 2;
        }
      }

      calculateResetPoint();
      window.addEventListener("resize", calculateResetPoint);

      function animateScroll() {
        if (resetPoint === 0) {
          calculateResetPoint();
        }

        scrollAmount += currentSpeed;
        currentSpeed = Math.max(baseSpeed, currentSpeed * decay);

        if (scrollAmount >= resetPoint) {
          scrollAmount = scrollAmount - resetPoint;
        }

        if (!track) return;
        track.style.transform = `translateX(-${scrollAmount}px)`;

        requestAnimationFrame(animateScroll);
      }

      container.addEventListener(
        "wheel",
        (event) => {
          event.preventDefault();
          event.stopPropagation();
          currentSpeed = fastSpeed;
        },
        { passive: false }
      );

      requestAnimationFrame(animateScroll);
    });
  </script>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,500;1,500&display=swap");

  @font-face {
    font-family: TexGyre;
    src: url("/fonts/texgyreheros-bold.otf") format("opentype");
  }
  * {
    font-family: TexGyre, sans-serif;
    font-weight: lighter;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background-color: #000;
    background-size: cover;
    margin: 0;
    color: #000;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    height: auto;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .div-text-copy,
  .text-frase p {
    font-size: 0.6rem;
  }
  input,
  textarea,
  select {
    cursor: text !important;
  }

  .custom-cursor-dot {
    position: fixed;
    width: 8px;
    height: 8px;
    background-color: #0073c0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 10000;
    transform: translate(-50%, -50%);
    transition:
      width 0.3s ease,
      height 0.3s ease;
    display: none;
  }

  .custom-cursor-dot.cursor-hover {
    width: 12px;
    height: 12px;
  }

  @media (min-width: 1142px) and (max-width: 1355px) {
    .div-text-copy,
    .text-frase p {
      font-size: 0.5rem;
    }
  }
  @media (min-width: 968px) and (max-width: 1141px) {
    .div-text-copy,
    .text-frase p {
      font-size: 0.4rem;
    }
  }

  .cursor-trail {
    position: fixed;
    width: 6px;
    height: 6px;
    background-color: #0073c0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    opacity: 0.6;
    display: none;
  }

  .deco-under {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .deco-under::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 1;
    pointer-events: none;
  }

  .deco-left {
    position: relative;
    width: 100%;
    flex-basis: auto;
    min-height: auto;
    max-height: none;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem 2rem 1rem;
    overflow: visible;
    z-index: 1;
  }
  .deco-left img {
    width: 85%;
    max-width: 280px;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }
  .deco-right {
    position: relative;
    width: 100%;
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    overflow-y: visible;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 3rem 1rem 2rem 1rem;
    z-index: 1;
    flex-direction: column;
    min-height: 0;
  }

  .h1-split {
    display: block;
    position: absolute;
    top: 30vh;
    left: auto;
    width: 90%;
    font-size: 12px !important;
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
  }

  .div-texts,
  .div-text-1,
  .div-text-copy,
  .a-ig,
  .a-fb,
  .a-web {
    display: none;
  }

  main {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    height: auto;
    position: relative;
  }

  @media (max-height: 700px) and (max-width: 967px) {
    .deco-left {
      padding: 1.5rem 1rem 1.5rem 1rem;
    }

    .deco-left img {
      width: 75%;
      max-width: 240px;
    }

    .h1-split {
      font-size: clamp(1.1rem, 3.5vw, 1.6rem);
      margin-top: 0.75rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
    }

    .deco-right {
      padding: 2rem 1rem 2rem 1rem;
    }
  }

  @media (min-width: 600px) and (max-width: 967px) {
    .deco-left {
      padding: 2.5rem 1rem 1.5rem 1rem;
    }

    .deco-left img {
      width: 70%;
      max-width: 320px;
    }

    .h1-split {
      font-size: clamp(1.5rem, 3.8vw, 2.2rem);
      margin-top: 1.5rem;
      margin-bottom: 2rem;
    }

    .deco-right {
      padding: 2.5rem 2rem 2rem 2rem;
    }
  }

  @media (max-height: 500px) and (max-width: 967px) and (orientation: landscape) {
    body {
      height: auto;
      min-height: 100%;
    }

    main {
      min-height: 100%;
    }

    .deco-left {
      padding: 1rem 1rem 0.5rem 1rem;
    }

    .deco-left img {
      width: 50%;
      max-width: 150px;
    }

    .h1-split {
      font-size: clamp(1rem, 3vw, 1.3rem);
      margin-top: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .deco-right {
      padding: 1rem 1rem 1.5rem 1rem;
    }
  }

  .text-frase {
    text-align: center;
    color: #fff;
    padding: 2rem 1rem;
    font-size: 0.7rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .text-frase p {
    font-family: "IBM Plex Mono", monospace;
    margin: 0;
    font-style: normal;
    font-weight: 500;
    text-transform: uppercase;
  }

  .auth-content {
    width: 100%;
  }

  .auth-content:has(.form-active) .text-frase {
    display: none !important;
  }

  @media (min-width: 968px) {
    body {
      display: block;
      overflow: hidden;
      cursor: none;
    }

    .custom-cursor-dot {
      display: block;
    }

    .cursor-trail {
      display: block;
    }

    main {
      display: block;
      height: 100vh;
      overflow: hidden;
      position: relative;
    }

    .text-frase {
      position: absolute;
      bottom: 1vh;
      right: 1vw;
      text-align: right;
      max-width: 100%;
    }

    .text-frase p {
      font-family: "IBM Plex Mono", monospace;
      font-style: normal;
      line-height: 1;
      color: #ffffff;
      opacity: 0.6;
      text-transform: uppercase;
    }

    .auth-content {
      max-width: 500px;
      margin: 0 auto;
    }

    .div-text-copy {
      display: block;
    }
    .a-ig {
      display: block;
      position: fixed;
      bottom: 15vh;
      left: 5vw;
      font-size: 22px;
      font-style: normal;
      text-decoration: none;
      font-weight: 500;
      color: #ffffff;
      opacity: 0.7;
      z-index: 1001;
    }
    .a-web {
      display: block;
      position: fixed;
      bottom: 15vh;
      left: 50%;
      transform: translateX(-50%);
      font-size: 22px;
      font-style: normal;
      font-weight: 500;
      color: #fff;
      opacity: 0.7;
      text-decoration: none;
      z-index: 1001;
    }
    .a-fb {
      display: block;
      position: fixed;
      bottom: 15vh;
      right: 5vw;
      font-size: 22px;
      font-style: normal;
      font-weight: 500;
      color: #ffffff;
      text-decoration: none;
      opacity: 0.7;
      z-index: 1001;
    }
    .deco-under {
      display: block;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 100%;
      z-index: 0;
    }

    .deco-under::after {
      display: block;
    }
    a:hover {
      text-decoration: underline;
    }
    .deco-left {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      transform: translate(0, -5%);
      padding: 0;
      flex-basis: auto;
      min-height: unset;
      max-height: unset;
      z-index: 999;
      pointer-events: none;
    }

    .deco-left img {
      max-width: none;
      width: 35%;
      height: auto;
      object-fit: cover;
      position: absolute;
      left: 2vw;
      top: 2vh;
      transform: translate(-20%, -40%);
      pointer-events: auto;
    }

    .deco-right {
      position: fixed;
      right: 0;
      top: 0;
      width: 100%;
      height: 100%;
      padding: 0;
      flex-direction: column;
      flex-grow: 0;
      justify-content: center;
      overflow-y: auto;
      z-index: 999;
    }

    .h1-split {
      display: none;
    }

    .div-texts {
      display: inline-block;
      text-align: center;
    }

    .div-text-1 {
      display: block;
      position: absolute;
      color: #fff;
      text-transform: uppercase;
      font-size: 16px;
      letter-spacing: 0;
      top: 10vh;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  @media (min-width: 1445px) {
    .text-frase p {
      font-size: 0.6rem;
    }
    .div-text-1 {
      font-size: 20px;
    }
  }

  h1 {
    display: none;
    position: absolute;
    top: 20px;
    left: 20px;
    font-size: 2.5rem;
    color: #fff;
    font-weight: normal;
  }
  .scroll-gallery {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .scroll-track {
    display: flex;
    height: 100%;
    will-change: transform;
    padding-bottom: 10px;
  }

  .scroll-track img {
    width: 50vw;
    height: 100%;
    padding: 0;
    object-fit: cover;
    border-radius: 10px;
    margin-right: 10px;
  }
  .div-text-copy {
    position: absolute;
    left: 1vw;
    font-family: "IBM Plex Mono", monospace;
    font-style: normal;
    font-weight: 500;
    bottom: 0vh;
    padding-bottom: 0;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.8;
    display: block;
    line-height: 1;
    margin: 0;
  }
</style>
