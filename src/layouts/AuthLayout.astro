---
const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galentreno</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <main>
      <div class="deco-left">
        <img src="/img/GALENTRENO.png" alt="Galentreno Logo" />

        <h1 class="h1-split">
          A TÚA PLATAFORMA DE ADESTRAMENTO 100% EN GALEGO
        </h1>
        <div class="div-texts">
          <div class="div-text-1">A TÚA</div>
          <div class="div-text-2">PLATAFORMA DE</div>
          <div class="div-text-3">ADESTRAMENTO</div>
          <div class="div-text-4">100% EN GALEGO</div>
        </div>
      </div>
      <div class="deco-right auth-card">
        <slot />
      </div>
      <div class="deco-under">
        <div class="scroll-gallery">
          <div class="scroll-track">
            <img src="/img/galeria/foto1.jpg" alt="Imaxe 1" />
            <img src="/img/galeria/foto2.jpg" alt="Imaxe 2" />
            <img src="/img/galeria/foto3.jpg" alt="Imaxe 3" />
            <img src="/img/galeria/foto1.jpg" alt="Imaxe 1" />
            <img src="/img/galeria/foto2.jpg" alt="Imaxe 2" />
            <img src="/img/galeria/foto3.jpg" alt="Imaxe 3" />
          </div>
        </div>
      </div>
    </main>
  </body>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const container = document.querySelector(".deco-under");
      const track = document.querySelector<HTMLElement>(".scroll-track");

      if (!container || !track) return;

      const baseSpeed = 0.3;
      const fastSpeed = 15;
      const decay = 0.98;

      let currentSpeed = baseSpeed;
      let scrollAmount = 0;
      let resetPoint = 0;

      function calculateResetPoint() {
        if (!track) return;
        const images = track.querySelectorAll("img");
        const totalImages = images.length;

        if (totalImages > 0) {
          // El punto de reset es la mitad del ancho total (donde termina el primer set)
          resetPoint = track.scrollWidth / 2;
        }
      }

      calculateResetPoint();
      window.addEventListener("resize", calculateResetPoint);

      function animateScroll() {
        if (resetPoint === 0) {
          calculateResetPoint();
        }

        scrollAmount += currentSpeed;
        currentSpeed = Math.max(baseSpeed, currentSpeed * decay);

        // Cuando llegamos al final del primer set, volvemos al inicio
        if (scrollAmount >= resetPoint) {
          scrollAmount = scrollAmount - resetPoint;
        }

        if (!track) return;
        track.style.transform = `translateX(-${scrollAmount}px)`;

        requestAnimationFrame(animateScroll);
      }

      container.addEventListener(
        "wheel",
        (event) => {
          event.preventDefault();
          event.stopPropagation();
          currentSpeed = fastSpeed;
        },
        { passive: false }
      );

      requestAnimationFrame(animateScroll);
    });
  </script>
</html>

<style is:global>
  @font-face {
    font-family: TexGyre;
    src: url("/fonts/texgyreheros-bold.otf") format("opentype");
  }
  * {
    font-family: TexGyre, sans-serif;
    font-weight: lighter;
    box-sizing: border-box;
  }

  body {
    background-color: #111;
    background-size: cover;
    margin: 0;
    color: #000;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }

  .deco-under {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50vh;
    z-index: 1;
    overflow: hidden;
  }

  .deco-left {
    position: relative;
    width: 100%;
    flex-basis: 40%;
    min-height: 250px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem 1.5rem 1rem;
    overflow: hidden;
  }
  .deco-left img {
    width: 60%;
    max-width: 180px;
    height: auto;
    object-fit: cover;
  }
  .deco-right {
    position: relative;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    overflow-y: auto;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 1rem 0 3rem 0;
    z-index: 2;
    flex-direction: column;
  }

  .h1-split {
    display: block;
    position: relative;
    top: auto;
    left: auto;
    width: 90%;
    margin-top: 1.5rem;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.1;
  }

  .div-texts,
  .div-text-1,
  .div-text-2,
  .div-text-3,
  .div-text-4 {
    display: none;
  }

  @media (min-width: 900px) {
    body {
      display: block;
    }
    .deco-under {
      display: block;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 50%;
    }
    .deco-left {
      position: fixed;
      top: 0;
      left: 0;
      width: 50%;
      height: 50%;
      transform: translate(0, -5%);
      padding: 0;
      flex-basis: auto;
    }
    .deco-left img {
      max-width: none;
      width: 70%;
      height: auto;
      object-fit: cover;
      position: absolute;
      left: 9.5vh;
      top: 0vw;
      transform: translate(-20%, -40%);
    }
    .deco-right {
      position: fixed;
      right: 0;
      top: 0;
      width: 50%;
      height: 50%;
      padding: 0;
      flex-direction: column;
      flex-grow: 0;
      justify-content: center;
      overflow-y: auto;
    }
    .h1-split {
      display: none;
    }
    .div-texts {
      display: inline-block;
      text-align: center;
    }
    .div-text-1,
    .div-text-2,
    .div-text-3,
    .div-text-4 {
      display: block;
      position: absolute;
      color: #fff;
      text-transform: uppercase;
      font-size: 50px;
      letter-spacing: -0.25rem;
    }
    .div-text-1 {
      top: 3vh;
      left: 27vw;
    }
    .div-text-2 {
      top: 12vh;
      left: 5.5vw;
    }
    .div-text-3 {
      top: 21vh;
      left: 5.5vw;
    }
    .div-text-4 {
      top: 30vh;
      left: 5.5vw;
    }
  }

  @media (min-width: 1445px) {
    .div-text-1,
    .div-text-2,
    .div-text-3,
    .div-text-4 {
      font-size: 80px;
    }
  }

  h1 {
    display: none;
    position: absolute;
    top: 20px;
    left: 20px;
    font-size: 2.5rem;
    color: #fff;
    font-weight: normal;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
  .scroll-gallery {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .scroll-track {
    display: flex;
    height: 100%;
    will-change: transform;
    padding-bottom: 10px;
  }

  .scroll-track img {
    width: 50vw;
    height: 100%;
    padding: 0;
    object-fit: cover;
    border-radius: 10px;
    margin-left: 10px;
    margin-right: 10px;
  }
</style>
