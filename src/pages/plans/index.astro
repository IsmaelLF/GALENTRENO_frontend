---
// src/pages/plans.astro
import AppLayout from "../../layouts/AppLayout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<AppLayout title="Plans Predefinidos">
  <h2>Plans Predefinidos</h2>
  <p>Explora as nosas rutinas creadas por expertos.</p>

  <div id="plans-list" class="plans-container">
    <p>Cargando plans...</p>
  </div>

  <style is:global>
    .plans-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
    }
    .plan-card {
      background-color: #112f63;
      color: white;
      padding: 1rem;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      border: 1px solid rgba(0, 0, 0, 0.05);
      text-decoration: none;
      display: block;
    }
    .plan-card h3 {
      margin-top: 0;
    }
  </style>

  <script type="module" define:vars={{ apiUrl: apiUrl }}>
    document.addEventListener("DOMContentLoaded", async () => {
      const listaPlans = document.getElementById("plans-list");

      try {
        const response = await fetch(`${apiUrl}/api/plans/predefinidos`);
        if (!response.ok) throw new Error("Non se puideron cargar os plans");
        if (!listaPlans) return;
        const plans = await response.json();
        listaPlans.innerHTML = "";

        if (plans.length === 0) {
          listaPlans.innerHTML =
            "<p>Non hai plans predefinidos dispoñibles.</p>";
        } else {
          plans.forEach((plan) => {
            const card = document.createElement("a");
            card.className = "plan-card";
            card.href = `/plans/${plan.id}`;
            card.innerHTML = `
                            <h3>${plan.nome}</h3>
                            <p>${plan.descricion || "Sen descrición."}</p>
                        `;
            listaPlans.appendChild(card);
          });
        }
      } catch (error) {
        console.error("Error:", error);
        if (!listaPlans) return;
        listaPlans.innerHTML = "<p>Error ao cargar os plans.</p>";
      }
    });
  </script>
</AppLayout>
