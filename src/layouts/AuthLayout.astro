---
const { title } = Astro.props;
---

<!doctype html>
<html lang="gl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galentreno</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="auth-backdrop" aria-hidden="true">
      <div class="glow-orb orb-1"></div>
      <div class="glow-orb orb-2"></div>
      <div class="grid-overlay"></div>
    </div>

    <main class="auth-shell">
      <h1 class="sr-only">Galentreno</h1>

      <header class="auth-topbar">
        <a href="/" class="brand-link" aria-label="Inicio Galentreno">
          <img src="/img/GALENTRENO.webp" alt="Galentreno Logo" />
        </a>

        <nav class="links-container" aria-label="Contacto profesional">
          <a
            class="linkedin-pill"
            href="https://www.linkedin.com/in/ismaellens/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar o perfil de LinkedIn de Ismael Lens"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
              ></path>
            </svg>
            <span>LinkedIn</span>
          </a>
        </nav>
      </header>

      <section class="deco-right auth-card">
        <div class="auth-content">
          <slot />
        </div>
      </section>

      <footer class="auth-footer">
        <p class="div-text-copy">© {new Date().getFullYear()} GALENTRENO</p>
        <div class="text-frase">
          <p>
            "Somos o que facemos repetidamente. A excelencia, daquela, non é un
            acto, senón un hábito." — Aristóteles
          </p>
        </div>
      </footer>
    </main>

    <script>
      import { gsap } from "gsap";

      document.addEventListener("DOMContentLoaded", () => {
        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        const authContent = document.querySelector(".auth-content");
        const brandLogo = document.querySelector(".brand-link");

        if (!prefersReducedMotion) {
          if (brandLogo) {
            gsap.fromTo(
              brandLogo,
              { opacity: 0, y: -12 },
              { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }
            );
          }

          if (authContent) {
            gsap.fromTo(
              authContent,
              { opacity: 0, y: 20, scale: 0.98 },
              {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 0.55,
                delay: 0.08,
                ease: "power3.out",
              }
            );
          }
        }

        const quotes = [
          '"Somos o que facemos repetidamente. A excelencia, daquela, non é un acto, senón un hábito." — Aristóteles',
          '"Unha viaxe de mil millas comeza cun só paso." — Lao-Tse',
          '"Non basta con saber, hai que aplicar. Non basta con querer, hai que facer." — J.W. von Goethe',
          '"A única maneira de descubrir os límites do posible é ir máis alá deles, cara ao imposible." — Arthur C. Clarke',
          '"Non teño talentos especiais. Só son apaixonadamente curioso." — Albert Einstein',
          '"Os únicos límites que tes son os límites que cres." — Wayne Dyer',
          '"Non te conformes con facelo suficientemente ben. Busca sempre facelo mellor." — Michael Jordan',
        ];

        const fraseElement = document.querySelector(
          ".text-frase p"
        ) as HTMLElement;
        let currentQuoteIndex = 0;

        const rotateQuote = () => {
          if (!fraseElement) return;

          if (!prefersReducedMotion) {
            gsap.to(fraseElement, {
              opacity: 0,
              y: 6,
              duration: 0.4,
              ease: "power2.in",
              onComplete: () => {
                currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
                fraseElement.textContent = quotes[currentQuoteIndex];
                gsap.fromTo(
                  fraseElement,
                  { opacity: 0, y: -6 },
                  { opacity: 0.75, y: 0, duration: 0.4, ease: "power2.out" }
                );
              },
            });
          } else {
            currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
            fraseElement.textContent = quotes[currentQuoteIndex];
          }
        };

        setInterval(rotateQuote, 6000);
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: TexGyre;
    src: url("/fonts/texgyreheros-bold.otf") format("opentype");
    font-display: swap;
  }

  :root {
    --auth-primary: #3b82f6;
    --auth-primary-hover: #2563eb;
    --auth-bg: #070b14;
    --auth-surface: rgba(15, 23, 42, 0.82);
    --auth-border: rgba(148, 163, 184, 0.16);
    --auth-text: #f8fafc;
    --auth-muted: #94a3b8;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Plus Jakarta Sans", TexGyre, -apple-system, BlinkMacSystemFont,
      sans-serif;
    background-color: var(--auth-bg);
    color: var(--auth-text);
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .auth-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(180deg, #070b14 0%, #0b1324 100%);
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.45;
  }

  .orb-1 {
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.35), transparent 70%);
    top: -120px;
    left: -100px;
  }

  .orb-2 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(29, 78, 216, 0.28), transparent 70%);
    bottom: -160px;
    right: -120px;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(148, 163, 184, 0.12) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    mask-image: radial-gradient(circle at center, black 35%, transparent 85%);
    -webkit-mask-image: radial-gradient(
      circle at center,
      black 35%,
      transparent 85%
    );
  }

  .auth-shell {
    position: relative;
    z-index: 2;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem clamp(1rem, 4vw, 3rem);
    gap: 1.5rem;
  }

  .auth-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-link:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }

  .brand-link img {
    height: clamp(68px, 9vw, 115px);
    width: auto;
    max-width: min(320px, 65vw);
    object-fit: contain;
    filter: drop-shadow(0 6px 20px rgba(59, 130, 246, 0.22));
  }

  .links-container {
    display: flex;
    align-items: center;
  }

  .linkedin-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--auth-text);
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid var(--auth-border);
    padding: 0.6rem 1.1rem;
    border-radius: 9999px;
    backdrop-filter: blur(10px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .linkedin-pill svg {
    color: #60a5fa;
    flex-shrink: 0;
  }

  .linkedin-pill:hover {
    background: rgba(59, 130, 246, 0.18);
    border-color: rgba(59, 130, 246, 0.55);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -4px rgba(59, 130, 246, 0.35);
  }

  .deco-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    width: 100%;
    padding: 0.5rem 0;
  }

  .auth-content {
    width: 100%;
    max-width: 440px;
    background: var(--auth-surface);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--auth-border);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow:
      0 25px 50px -12px rgba(2, 6, 23, 0.85),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  .auth-footer {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding-top: 0.5rem;
  }

  .div-text-copy {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    color: var(--auth-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .text-frase {
    max-width: 640px;
    text-align: center;
  }

  .text-frase p {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    line-height: 1.5;
    color: #cbd5e1;
    opacity: 0.75;
  }

  @media (min-width: 968px) {
    .auth-footer {
      flex-direction: row;
    }

    .text-frase {
      text-align: right;
    }
  }

  @media (max-width: 640px) {
    .auth-shell {
      padding: 1.25rem 1rem;
      gap: 1.25rem;
    }

    .auth-topbar {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    .brand-link img {
      height: 76px;
      max-width: 80vw;
    }

    .auth-content {
      padding: 1.35rem 1.15rem;
      border-radius: 1rem;
    }
  }
</style>