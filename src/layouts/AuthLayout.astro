---
const { title } = Astro.props;
---

<html lang="gl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galentreno</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script
      src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"
      is:inline></script>
  </head>
  <body>
    <main>
      <h1 style="display: none">Galentreno</h1>
      <div class="deco-left">
        <a href="/"><img src="/img/GALENTRENO.webp" alt="Galentreno Logo" /></a>

        <div class="div-texts">
          <p class="div-text-copy">Copyright 2025 GALENTRENO</p>
        </div>
      </div>
      <!-- <div class="links-container">
        <a
          class="a-ig"
          href="https://instagram.com/galentreno"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visitar o noso perfil de Instagram">INSTAGRAM</a
        >
        <a
          class="a-web"
          href="https://galentreno.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ir á páxina web principal de Galentreno">(WEB)</a
        >
        <a
          class="a-fb"
          href="https://facebook.com/galentreno"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visitar a nosa páxina de Facebook">FACEBOOK</a
        >
      </div> -->
      <div class="deco-right auth-card">
        <div class="auth-content">
          <slot />
          <div class="text-frase">
            <p>
              "Somos o que facemos repetidamente. A excelencia, daquela, non é
              un acto, senón un hábito." - Aristóteles
            </p>
          </div>
        </div>
      </div>
      <div class="deco-under">
        <div class="scroll-gallery">
          <div class="scroll-track">
            <img
              fetchpriority="high"
              src="/img/galeria/foto1.webp"
              alt="Imaxe 1"
              loading="lazy"
            />
            <img
              fetchpriority="high"
              src="/img/galeria/foto2.webp"
              alt="Imaxe 2"
              loading="lazy"
            />
            <img
              fetchpriority="high"
              src="/img/galeria/foto3.webp"
              alt="Imaxe 3"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </main>
  </body>
  <script>
    declare const gsap: any;

    document.addEventListener("DOMContentLoaded", () => {
      // Check if GSAP is loaded
      if (typeof gsap === "undefined") {
        console.warn(
          "GSAP library failed to load. Some animations will be disabled."
        );
      }

      // Check for reduced motion preference
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      // Custom cursor (only if user doesn't prefer reduced motion)
      if (!prefersReducedMotion && window.innerWidth >= 968) {
        const cursorDot = document.createElement("div");
        cursorDot.classList.add("custom-cursor-dot");
        document.body.appendChild(cursorDot);

        let mouseX = 0;
        let mouseY = 0;
        const trail: HTMLElement[] = [];
        const maxTrail = 15;

        document.addEventListener("mousemove", (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;

          cursorDot.style.left = mouseX + "px";
          cursorDot.style.top = mouseY + "px";

          const trailDot = document.createElement("div");
          trailDot.classList.add("cursor-trail");
          trailDot.style.left = mouseX + "px";
          trailDot.style.top = mouseY + "px";
          document.body.appendChild(trailDot);

          trail.push(trailDot);

          if (trail.length > maxTrail) {
            const oldDot = trail.shift();
            if (oldDot) oldDot.remove();
          }

          setTimeout(() => {
            trailDot.style.opacity = "0";
            trailDot.style.transform = "translate(-50%, -50%) scale(0)";
          }, 10);
        });

        document.querySelectorAll("a, button").forEach((el) => {
          el.addEventListener("mouseenter", () => {
            cursorDot.classList.add("cursor-hover");
          });
          el.addEventListener("mouseleave", () => {
            cursorDot.classList.remove("cursor-hover");
          });
        });
      }

      const track = document.querySelector(".scroll-track") as HTMLElement;

      if (!track) return;

      // Duplicate images for infinite scroll effect
      const originalImages = Array.from(track.querySelectorAll("img"));
      originalImages.forEach((img) => {
        const clone = img.cloneNode(true) as HTMLElement;
        track.appendChild(clone);
      });

      const baseSpeed = prefersReducedMotion ? 0.1 : 0.25;
      let scrollAmount = 0;
      let resetPoint = 0;

      function calculateResetPoint() {
        if (!track) return;
        const images = track.querySelectorAll("img");
        const totalImages = images.length;

        if (totalImages > 0) {
          resetPoint = track.scrollWidth / 2;
        }
      }

      calculateResetPoint();
      window.addEventListener("resize", calculateResetPoint);

      function animateScroll() {
        if (resetPoint === 0) {
          calculateResetPoint();
        }

        scrollAmount += baseSpeed;

        if (scrollAmount >= resetPoint) {
          scrollAmount = scrollAmount - resetPoint;
        }

        if (!track) return;
        track.style.transform = `translateX(-${scrollAmount}px)`;

        requestAnimationFrame(animateScroll);
      }

      requestAnimationFrame(animateScroll);

      const linksContainer = document.querySelector(
        ".links-container"
      ) as HTMLElement;
      const authContainer = document.querySelector(".auth-card");

      if (linksContainer && authContainer && window.innerWidth < 968) {
        const observer = new MutationObserver(() => {
          if (authContainer.classList.contains("form-active")) {
            linksContainer.style.opacity = "0";
            linksContainer.style.pointerEvents = "none";
          } else {
            linksContainer.style.opacity = "1";
            linksContainer.style.pointerEvents = "auto";
          }
        });

        observer.observe(authContainer, {
          attributes: true,
          attributeFilter: ["class"],
        });

        if (authContainer.classList.contains("form-active")) {
          linksContainer.style.opacity = "0";
          linksContainer.style.pointerEvents = "none";
        }
      }

      const quotes = [
        '"Somos o que facemos repetidamente. A excelencia, daquela, non é un acto, senón un hábito." - Aristóteles',
        '"Unha viaxe de mil millas comeza cun só paso" - Lao-Tse',
        '"Non basta con saber, hai que aplicar. Non basta con querer, hai que facer." Johann Wolfgang von Goethe',
        '"A única maneira de descubrir os límites do posible é ir máis alá deles, cara ao imposible." - Arthur C. Clarke',
        '"Non teño talentos especiais. Só son apaixonadamente curioso." - Albert Einstein',
        '"Os únicos límites que tes son os límites que cres." - Wayne Dyer',
        '"Non te conformes con facelo ¨suficientemente ben¨. Busca sempre facelo mellor." - Michael Jordan',
      ];

      const fraseElement = document.querySelector(
        ".text-frase p"
      ) as HTMLElement;
      let currentQuoteIndex = 0;

      function rotateQuote() {
        if (!fraseElement) return;

        if (typeof gsap !== "undefined" && !prefersReducedMotion) {
          // Use GSAP animations if available and user doesn't prefer reduced motion
          gsap.to(fraseElement, {
            opacity: 0,
            y: 10,
            duration: 0.6,
            ease: "power2.in",
            onComplete: () => {
              currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
              fraseElement.textContent = quotes[currentQuoteIndex];

              gsap.fromTo(
                fraseElement,
                { opacity: 0, y: -10 },
                { opacity: 0.6, y: 0, duration: 0.6, ease: "power2.out" }
              );
            },
          });
        } else {
          // Fallback to simple fade without GSAP
          fraseElement.style.transition = prefersReducedMotion
            ? "none"
            : "opacity 0.6s ease";
          fraseElement.style.opacity = "0";

          setTimeout(
            () => {
              currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
              fraseElement.textContent = quotes[currentQuoteIndex];
              fraseElement.style.opacity = "0.6";
            },
            prefersReducedMotion ? 0 : 600
          );
        }
      }

      setInterval(rotateQuote, 5000);
    });
  </script>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,500;1,500&display=swap");

  @font-face {
    font-family: TexGyre;
    src: url("/fonts/texgyreheros-bold.otf") format("opentype");
  }
  * {
    font-family: TexGyre, sans-serif;
    font-weight: lighter;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
    margin: 0;
    padding: 0;
  }

  /* Respect user's motion preferences */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  body {
    background-color: #000;
    background-size: cover;
    margin: 0;
    padding: 0;
    color: #000;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    height: auto;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .div-text-copy,
  .text-frase p {
    font-size: 0.6rem;
  }
  input,
  textarea,
  select {
    cursor: text !important;
  }

  .custom-cursor-dot {
    position: fixed;
    width: 8px;
    height: 8px;
    background-color: #0073c0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 10000;
    transform: translate(-50%, -50%);
    transition:
      width 0.3s ease,
      height 0.3s ease;
    display: none;
  }

  .custom-cursor-dot.cursor-hover {
    width: 12px;
    height: 12px;
  }

  @media (min-width: 1142px) and (max-width: 1355px) {
    .div-text-copy {
      font-size: 0.5rem;
    }
  }

  .cursor-trail {
    position: fixed;
    width: 6px;
    height: 6px;
    background-color: #0073c0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    opacity: 0.6;
    display: none;
  }

  .deco-under {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .deco-under::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #11111171;
    z-index: 1;
    pointer-events: none;
  }

  .deco-left {
    position: relative;
    width: 100%;
    flex-basis: auto;
    min-height: auto;
    max-height: none;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem 2rem 1rem;
    overflow: visible;
    z-index: 1;
  }
  .deco-left img {
    width: 85%;
    max-width: 280px;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }
  .deco-right {
    position: relative;
    width: 100%;
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    overflow-y: visible;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 3rem 1rem 2rem 1rem;
    z-index: 1;
    flex-direction: column;
    min-height: 0;
  }

  .div-texts,
  .div-text-1,
  .div-text-copy {
    display: none;
  }

  .links-container {
    position: fixed;
    bottom: 15vh;
    left: 5vw;
    right: 5vw;
    display: flex;
    justify-content: space-between;
    z-index: 1001;
  }

  .a-ig,
  .a-fb,
  .a-web {
    font-size: 16px;
    font-style: normal;
    text-decoration: none;
    font-weight: 500;
    color: #ffffff;
    opacity: 0.7;
    cursor: none;
  }

  .text-frase {
    display: block;
    position: fixed;
    bottom: 0vh;
    right: 1vw;
    left: 1vw;
    text-align: center;
    z-index: 1001;
    font-size: 10px;
  }
  .text-frase p {
    font-family: "IBM Plex Mono", monospace;
    font-style: normal;
    line-height: 1.2;
    color: #ffffff;
    opacity: 0.6;
    text-transform: uppercase;
    margin: 0;
  }

  main {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    height: auto;
    position: relative;
    margin: 0;
    padding: 0;
  }

  @media (max-height: 700px) and (max-width: 967px) {
    .deco-left {
      padding: 1.5rem 1rem 1.5rem 1rem;
    }

    .deco-left img {
      width: 75%;
      max-width: 240px;
    }

    .deco-right {
      padding: 2rem 1rem 2rem 1rem;
    }
  }

  @media (min-width: 600px) and (max-width: 967px) {
    .deco-left {
      padding: 2.5rem 1rem 1.5rem 1rem;
    }

    .deco-left img {
      width: 70%;
      max-width: 320px;
    }

    .deco-right {
      padding: 2.5rem 2rem 2rem 2rem;
    }
  }

  @media (max-height: 500px) and (max-width: 967px) and (orientation: landscape) {
    body {
      height: auto;
      min-height: 100%;
    }

    main {
      min-height: 100%;
    }

    .deco-left {
      padding: 1rem 1rem 0.5rem 1rem;
    }

    .deco-left img {
      width: 50%;
      max-width: 150px;
    }

    .deco-right {
      padding: 1rem 1rem 1.5rem 1rem;
    }
  }

  .text-frase {
    text-align: center;
    color: #fff;
    padding: 2rem 1rem;
    font-size: 0.7rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .text-frase p {
    font-family: "IBM Plex Mono", monospace;
    margin: 0;
    font-style: normal;
    font-weight: 500;
    text-transform: uppercase;
  }

  .auth-content {
    width: 100%;
  }

  .auth-content:has(.form-active) .text-frase {
    display: none !important;
  }

  @media (min-width: 968px) {
    body {
      display: block;
      overflow: hidden;
    }

    /* Only hide default cursor if custom cursor is supported and user doesn't prefer reduced motion */
    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      body {
        cursor: none;
      }

      .custom-cursor-dot {
        display: block;
      }

      .cursor-trail {
        display: block;
      }
    }

    main {
      display: block;
      height: 100vh;
      overflow: hidden;
      position: relative;
    }

    .text-frase {
      position: absolute;
      bottom: 1vh;
      right: 1vw;
      left: auto;
      text-align: right;
      max-width: 100%;
      font-size: 0.6rem;
    }

    .text-frase p {
      font-family: "IBM Plex Mono", monospace;
      font-style: normal;
      line-height: 1;
      color: #ffffff;
      opacity: 0.6;
      text-transform: uppercase;
    }

    .auth-content {
      max-width: 500px;
      margin: 0 auto;
    }

    .div-text-copy {
      display: block;
      position: absolute;
      left: 1vw;
      bottom: 0vh;
      font-family: "IBM Plex Mono", monospace;
      font-style: normal;
      font-weight: 500;
      text-transform: uppercase;
      color: #ffffff;
      opacity: 0.8;
      line-height: 1;
      margin: 0;
      z-index: 1001;
      font-size: 0.6rem;
    }

    .links-container {
      top: 5dvh;
      bottom: auto;
      left: 55%;
      right: 2vw;
    }

    .a-ig,
    .a-fb,
    .a-web {
      font-size: 20px;
    }
    .deco-under {
      display: block;
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 100%;
      z-index: 0;
    }

    .deco-under::after {
      display: block;
    }
    a:hover {
      text-decoration: underline;
    }
    .deco-left {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      transform: translate(0, -5%);
      padding: 0;
      flex-basis: auto;
      min-height: unset;
      max-height: unset;
      z-index: 999;
      pointer-events: none;
    }

    .deco-left img {
      max-width: none;
      width: 35%;
      height: auto;
      object-fit: cover;
      position: absolute;
      left: 2vw;
      top: 2vh;
      transform: translate(-20%, -40%);
      pointer-events: auto;
    }

    .deco-right {
      position: fixed;
      right: 0;
      top: 0;
      width: 100%;
      height: 100%;
      padding: 0;
      flex-direction: column;
      flex-grow: 0;
      justify-content: center;
      overflow-y: auto;
      z-index: 999;
    }

    .div-texts {
      display: inline-block;
      text-align: center;
    }

    .div-text-1 {
      display: block;
      position: absolute;
      color: #fff;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 0;
      margin-right: 2dvh;
      top: 10vh;
      left: 65dvw;
    }
  }

  @media (min-width: 1445px) {
    .text-frase p {
      font-size: 0.6rem;
      margin-bottom: 0.5rem;
    }
  }

  .scroll-gallery {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .scroll-track {
    display: flex;
    height: 100%;
    will-change: transform;
    padding: 1dvh;
  }

  .scroll-track img {
    width: 50vw;
    height: 100%;
    padding: 0;
    object-fit: cover;
    filter: saturate(30%);
    border-radius: 10px;
    margin-right: 10px;
  }

  @media (max-width: 967px) {
    .scroll-track img {
      width: 95vw;
    }
  }

  @media (max-width: 358px) {
    .deco-left {
      padding: 1.5rem 0.5rem 1.5rem 0.5rem;
    }

    .deco-left img {
      width: 90%;
      max-width: 220px;
    }

    .deco-right {
      padding: 2rem 0.5rem 1.5rem 0.5rem;
    }

    .links-container {
      left: 3vw;
      right: 3vw;
      bottom: 13vh;
    }

    .a-ig,
    .a-fb,
    .a-web {
      font-size: 13px;
    }

    .text-frase {
      font-size: 8px;
      left: 0.5vw;
      right: 0.5vw;
    }

    .text-frase p {
      line-height: 1.1;
    }
  }
</style>
