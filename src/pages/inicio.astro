---
import AppLayout from "../layouts/AppLayout.astro";
import { format } from "date-fns";
import { gl } from "date-fns/locale";
const diaActual = new Date();
const dataFormateada = format(diaActual, "EEEE, d MMMM", { locale: gl });
const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<AppLayout title="GALENTRENO">
  <h1 id="user-greeting">Ola!</h1>
  <small id="current-date" data-data-formateada={dataFormateada}></small>

  <div class="stats-grid">
    <div class="card"><strong>--</strong><br />Adestramentos</div>
    <div class="card"><strong>--</strong><br />Volume total</div>
    <div class="card"><strong>--</strong><br />Esta semana</div>
  </div>

  <a href="/meus-plans" class="button button-primary">+ Novo Entrenamento</a>

  <script type="module" define:vars={{ apiUrl: apiUrl }}>
    document.addEventListener("DOMContentLoaded", async () => {
      const token = localStorage.getItem("jwt_token");

      if (!token) {
        window.location.href = "/";
        return;
      }

      const dataActual = document.getElementById("current-date");
      if (!dataActual) return;
      else {
        dataActual.textContent = dataActual.dataset.dataFormateada;
      }
      try {
        const response = await fetch(`${apiUrl}/api/sesions/recentes`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        const saudo = document.getElementById("user-greeting");
        if (!saudo) return;
        if (response.ok) {
          const data = await response.json();

          saudo.textContent = `Ola, ${data.nome}! Preparado para adestrar?`;
        } else {
          saudo.textContent = `Ola!`;
        }
      } catch (error) {
        console.error("Erro obtendo datos do usuario:", error);
      }
    });
  </script>
</AppLayout>
