---
import AppLayout from "../../layouts/AppLayout.astro";
export const prerender = false;
---

<AppLayout title="Adestramento">
  <div class="training-wrapper">
    <div class="training-header">
      <h1 id="plan-name">Adestramento</h1>
      <p id="plan-description"></p>
    </div>

    <div class="info-box">
      <svg
        class="info-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <p>
        <strong>Rexistro en tempo real:</strong> Se modificas as series,
        repeticións ou o peso suxerido, gardarase a execución real que fixeches
        hoxe para calcular o teu progreso.
      </p>
    </div>

    <div id="training-content">
      <p>Cargando exercicios...</p>
    </div>

    <div class="training-actions">
      <button id="cancel-training-btn" class="button button-secondary">
        Cancelar
      </button>
      <button id="finish-training-btn" class="button" disabled>
        Finalizar Adestramento
      </button>
    </div>
  </div>

  <style is:global>
    .training-wrapper {
      max-width: 840px;
      margin: 0 auto;
    }

    .training-header {
      text-align: left;
      margin-bottom: var(--spacing-xl);
    }

    .training-header h1 {
      text-align: left;
      margin-bottom: 0.25rem;
    }

    .training-header p {
      color: var(--color-text-muted);
      margin: 0;
    }

    .info-box {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      padding: 1rem 1.25rem;
      border-radius: var(--radius-lg);
      margin-bottom: var(--spacing-xl);
      display: flex;
      gap: var(--spacing-md);
      align-items: flex-start;
    }

    .info-icon {
      color: var(--color-primary);
      flex-shrink: 0;
      margin-top: 0.15rem;
    }

    .info-box p {
      margin: 0;
      font-size: var(--font-size-sm);
    }

    .exercicio-card {
      background: var(--color-bg-card);
      backdrop-filter: blur(12px);
      padding: var(--spacing-xl);
      border-radius: var(--radius-xl);
      margin-bottom: var(--spacing-lg);
      border: 1px solid var(--color-border);
    }

    .exercicio-card h3 {
      margin-top: 0;
      margin-bottom: 0.25rem;
    }

    .exercicio-info {
      color: var(--color-primary);
      font-size: var(--font-size-sm);
      font-weight: 600;
      margin-bottom: var(--spacing-lg);
    }

    .series-container {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .serie-row {
      display: grid;
      grid-template-columns: 90px 1fr 1fr;
      gap: var(--spacing-md);
      align-items: center;
      padding: 0.875rem 1rem;
      background: rgba(9, 13, 22, 0.65);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
    }

    .serie-label {
      font-weight: 700;
      color: var(--color-text-primary);
      font-size: var(--font-size-sm);
    }

    .input-group-inline {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .training-actions {
      display: flex;
      gap: var(--spacing-md);
      justify-content: flex-end;
      margin-top: var(--spacing-xl);
    }

    @media (max-width: 640px) {
      .serie-row {
        grid-template-columns: 1fr 1fr;
      }

      .serie-label {
        grid-column: 1 / -1;
      }

      .training-actions {
        flex-direction: column-reverse;
      }

      .training-actions button {
        width: 100%;
      }
    }
  </style>

  <script src="../../scripts/sesion-adestramento.js"></script>
</AppLayout>