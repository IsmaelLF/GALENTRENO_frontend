---
const { title } = Astro.props;
---

<!doctype html>
<html lang="gl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galentreno</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="auth-backdrop" aria-hidden="true"></div>

    <main class="auth-shell">
      <h1 class="sr-only">Galentreno</h1>

      <header class="auth-topbar">
        <a href="/" class="brand-link" aria-label="Inicio Galentreno">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">GALENTRENO</span>
        </a>

        <nav class="links-container" aria-label="Contacto profesional">
          <a
            class="linkedin-pill"
            href="https://www.linkedin.com/in/ismaellens/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar o perfil de LinkedIn de Ismael Lens"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
              ></path>
            </svg>
            <span>LinkedIn</span>
          </a>
        </nav>
      </header>

      <section class="deco-right auth-card">
        <div class="auth-content">
          <slot />
        </div>
      </section>

      <footer class="auth-footer">
        <p class="div-text-copy">© {new Date().getFullYear()} GALENTRENO</p>
        <div class="text-frase">
          <p>
            "Somos o que facemos repetidamente. A excelencia, daquela, non é un
            acto, senón un hábito." — Aristóteles
          </p>
        </div>
      </footer>
    </main>

    <script>
      import { gsap } from "gsap";

      document.addEventListener("DOMContentLoaded", () => {
        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        const authContent = document.querySelector(".auth-content");
        const brandLogo = document.querySelector(".brand-link");

        if (!prefersReducedMotion) {
          if (brandLogo) {
            gsap.fromTo(
              brandLogo,
              { opacity: 0, y: -12 },
              { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }
            );
          }

          if (authContent) {
            gsap.fromTo(
              authContent,
              { opacity: 0, y: 20, scale: 0.98 },
              {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 0.55,
                delay: 0.08,
                ease: "power3.out",
              }
            );
          }
        }

        const quotes = [
          '"Somos o que facemos repetidamente. A excelencia, daquela, non é un acto, senón un hábito." — Aristóteles',
          '"Unha viaxe de mil millas comeza cun só paso." — Lao-Tse',
          '"Non basta con saber, hai que aplicar. Non basta con querer, hai que facer." — J.W. von Goethe',
          '"A única maneira de descubrir os límites do posible é ir máis alá deles, cara ao imposible." — Arthur C. Clarke',
          '"Non teño talentos especiais. Só son apaixonadamente curioso." — Albert Einstein',
          '"Os únicos límites que tes son os límites que cres." — Wayne Dyer',
          '"Non te conformes con facelo suficientemente ben. Busca sempre facelo mellor." — Michael Jordan',
        ];

        const fraseElement = document.querySelector(
          ".text-frase p"
        ) as HTMLElement;
        let currentQuoteIndex = 0;

        const rotateQuote = () => {
          if (!fraseElement) return;

          if (!prefersReducedMotion) {
            gsap.to(fraseElement, {
              opacity: 0,
              y: 6,
              duration: 0.4,
              ease: "power2.in",
              onComplete: () => {
                currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
                fraseElement.textContent = quotes[currentQuoteIndex];
                gsap.fromTo(
                  fraseElement,
                  { opacity: 0, y: -6 },
                  { opacity: 0.75, y: 0, duration: 0.4, ease: "power2.out" }
                );
              },
            });
          } else {
            currentQuoteIndex = (currentQuoteIndex + 1) % quotes.length;
            fraseElement.textContent = quotes[currentQuoteIndex];
          }
        };

        setInterval(rotateQuote, 6000);
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: TexGyre;
    src: url("/fonts/texgyreheros-bold.otf") format("opentype");
    font-display: swap;
  }

  :root {
    --auth-primary: #a78bdf;
    --auth-primary-hover: #b59ce9;
    --auth-primary-light: rgba(167, 139, 223, 0.12);
    --auth-bg: #1b1920;
    --auth-surface: #292630;
    --auth-border: rgba(233, 225, 245, 0.1);
    --auth-text: #f2eef7;
    --auth-muted: #a29aaa;
    --auth-text-secondary: #d0cad8;
    --auth-input: #211f27;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Plus Jakarta Sans", TexGyre, -apple-system, BlinkMacSystemFont,
      sans-serif;
    background-color: var(--auth-bg);
    color: var(--auth-text);
    color-scheme: dark;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .auth-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--auth-bg);
  }

  .auth-shell {
    position: relative;
    z-index: 2;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem clamp(1rem, 4vw, 3rem);
    gap: 1.5rem;
  }

  .auth-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--auth-text);
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .brand-link:hover {
    transform: translateY(-1px);
    opacity: 0.95;
    color: var(--auth-text);
  }

  .brand-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--auth-primary);
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .links-container {
    display: flex;
    align-items: center;
  }

  .linkedin-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--auth-text);
    background: #24212a;
    border: 1px solid var(--auth-border);
    padding: 0.6rem 1.1rem;
    border-radius: 9999px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .linkedin-pill svg {
    color: var(--auth-primary);
    flex-shrink: 0;
  }

  .linkedin-pill:hover {
    background: var(--auth-primary-light);
    border-color: rgba(167, 139, 223, 0.35);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -4px rgba(118, 86, 214, 0.18);
  }

  .deco-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    width: 100%;
    padding: clamp(1.5rem, 4vh, 3rem) 0;
  }

  .auth-content {
    width: 100%;
    max-width: 440px;
    background: var(--auth-surface);
    border: 1px solid var(--auth-border);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
  }

  .auth-content:has(.welcome-screen) {
    width: 100%;
    max-width: 1120px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .auth-footer {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    border-top: 1px solid var(--auth-border);
    padding-top: 1.1rem;
  }

  .div-text-copy {
    font-size: 0.75rem;
    color: var(--auth-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .text-frase {
    max-width: 640px;
    text-align: center;
  }

  .text-frase p {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--auth-muted);
    opacity: 1;
  }

  @media (min-width: 968px) {
    .auth-footer {
      flex-direction: row;
    }

    .text-frase {
      text-align: right;
    }
  }

  @media (max-width: 640px) {
    .auth-shell {
      padding: 1.25rem 1rem;
      gap: 1.25rem;
    }

    .brand-name {
      font-size: 1rem;
    }

    .auth-content {
      padding: 1.35rem 1.15rem;
      border-radius: 1rem;
    }

    .auth-content:has(.welcome-screen) {
      padding: 0;
    }

    .deco-right {
      padding: 1rem 0;
    }
  }
</style>