---
import AppLayout from "../../layouts/AppLayout.astro";
import CrearPlan from "../../components/CrearPlan.vue";
---

<AppLayout title="Crear Novo Plan">
  <div class="page-header">
    <h2>Crear un novo plan de adestramento</h2>
    <p class="page-description">
      Escolle unha plantilla predefinida ou deseña a túa propia rutina desde cero.
    </p>
  </div>

  <div class="plan-options-container">
    <div class="option-card">
      <span class="option-badge">Recomendado para comezar</span>
      <h3>Plans Predefinidos</h3>
      <p>
        Escolle entre os nosos plans creados por expertos para diferentes
        obxectivos e niveis.
      </p>
      <a href="/plans" class="button button-secondary">Ver Plans Predefinidos</a>
    </div>

    <div class="option-card highlighted">
      <span class="option-badge primary">Control total</span>
      <h3>Plan Personalizado</h3>
      <p>
        Configura os teus propios días, exercicios, series e pesos obxectivo
        paso a paso.
      </p>
      <button id="show-custom-form" class="button">
        Crear Plan Personalizado
      </button>
    </div>
  </div>

  <div id="custom-plan-form" class="custom-form-container" style="display: none;">
    <div class="form-header">
      <h3>Deseña o teu plan personalizado</h3>
      <button id="hide-custom-form" class="button-close" aria-label="Pechar formulario">
        ✕
      </button>
    </div>
    <CrearPlan client:load />
  </div>

  <style>
    .page-header {
      text-align: center;
      margin-bottom: var(--spacing-2xl);
    }

    .page-header h2 {
      margin-top: 0;
    }

    .page-description {
      color: var(--color-text-muted);
      max-width: 560px;
      margin: 0 auto;
    }

    .plan-options-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--spacing-xl);
      margin-bottom: var(--spacing-2xl);
    }

    .option-card {
      background: var(--color-bg-card);
      padding: var(--spacing-xl);
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      transition: transform var(--transition-base), border-color var(--transition-base);
    }

    .option-card:hover {
      border-color: var(--color-border-hover);
      transform: translateY(-3px);
    }

    .option-card.highlighted {
      border-color: var(--color-border-hover);
      background: var(--color-bg-card);
    }

    .option-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.3rem 0.7rem;
      border-radius: 9999px;
      background: rgba(233, 225, 245, 0.08);
      color: var(--color-text-secondary);
      margin-bottom: 1rem;
    }

    .option-badge.primary {
      background: var(--color-primary-light);
      color: var(--color-primary);
    }

    .option-card p {
      color: var(--color-text-muted);
      margin-bottom: var(--spacing-xl);
      flex: 1;
    }

    .option-card .button {
      width: 100%;
    }

    .custom-form-container {
      background: var(--color-bg-card);
      padding: var(--spacing-xl);
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-border-hover);
      margin-top: var(--spacing-xl);
    }

    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--spacing-xl);
      padding-bottom: var(--spacing-md);
      border-bottom: 1px solid var(--color-border);
    }

    .form-header h3 {
      margin: 0;
    }

    .button-close {
      background: transparent;
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      cursor: pointer;
      width: 34px;
      height: 34px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .button-close:hover {
      color: var(--color-text-primary);
      border-color: var(--color-border-hover);
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const showFormBtn = document.getElementById("show-custom-form");
      const hideFormBtn = document.getElementById("hide-custom-form");
      const customFormContainer = document.getElementById("custom-plan-form");

      if (showFormBtn && customFormContainer) {
        showFormBtn.addEventListener("click", () => {
          customFormContainer.style.display = "block";
          customFormContainer.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        });
      }

      if (hideFormBtn && customFormContainer) {
        hideFormBtn.addEventListener("click", () => {
          customFormContainer.style.display = "none";
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }
    });
  </script>
</AppLayout>