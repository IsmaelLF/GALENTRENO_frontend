---
// src/pages/plans/novo.astro
import AppLayout from "../../layouts/AppLayout.astro";
import CrearPlan from "../../components/CrearPlan.vue";
---

<AppLayout title="Crear Novo Plan">
  <div class="page-header">
    <h2>Crear un novo plan de adestramento</h2>
    <p class="page-description">
      Escolle unha das opcións a continuación para comezar co teu plan personalizado
    </p>
  </div>

  <div class="plan-options-container">
    <div class="option-card">
      <div class="option-icon">📋</div>
      <h3>Plans Predefinidos</h3>
      <p>Escolle entre os nosos plans creados por expertos, deseñados para diferentes obxectivos e niveis</p>
      <a href="/plans" class="button button-secondary">Ver Plans Predefinidos</a>
    </div>

    <div class="option-divider">
      <span>OU</span>
    </div>

    <div class="option-card highlighted">
      <div class="option-icon">✏️</div>
      <h3>Plan Personalizado</h3>
      <p>Crea o teu propio plan desde cero, adaptado ás túas necesidades específicas</p>
      <button id="show-custom-form" class="button button-primary">Crear Plan Personalizado</button>
    </div>
  </div>

  <div id="custom-plan-form" class="custom-form-container" style="display: none;">
    <div class="form-header">
      <h3>Deseña o teu plan personalizado</h3>
      <button id="hide-custom-form" class="button-close" aria-label="Pechar formulario">×</button>
    </div>
    <CrearPlan client:load />
  </div>

  <style>
    .page-header {
      text-align: center;
      margin-bottom: var(--spacing-2xl);
    }

    .page-header h2 {
      margin-bottom: var(--spacing-sm);
      color: var(--color-text-primary);
    }

    .page-description {
      color: var(--color-text-muted);
      font-size: var(--font-size-lg);
      max-width: 600px;
      margin: 0 auto;
    }

    .plan-options-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: var(--spacing-xl);
      align-items: center;
      margin-bottom: var(--spacing-2xl);
    }

    .option-card {
      background-color: var(--color-bg-card);
      padding: var(--spacing-2xl);
      border-radius: var(--radius-lg);
      border: 2px solid var(--color-border);
      text-align: center;
      transition: all 0.3s ease;
    }

    .option-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(13, 110, 253, 0.15);
    }

    .option-card.highlighted {
      border-color: var(--color-primary);
      background: linear-gradient(135deg, rgba(13, 110, 253, 0.05) 0%, rgba(13, 110, 253, 0.02) 100%);
    }

    .option-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
    }

    .option-card h3 {
      margin-top: 0;
      margin-bottom: var(--spacing-md);
      color: var(--color-text-primary);
    }

    .option-card p {
      color: var(--color-text-muted);
      margin-bottom: var(--spacing-xl);
      min-height: 3em;
      line-height: 1.5;
    }

    .option-card .button {
      width: 100%;
      margin-top: auto;
    }

    .option-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      position: relative;
    }

    .option-divider::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      background: linear-gradient(to bottom,
        transparent 0%,
        var(--color-border) 20%,
        var(--color-border) 80%,
        transparent 100%);
      transform: translateX(-50%);
    }

    .option-divider span {
      background-color: var(--color-bg-main);
      padding: var(--spacing-md);
      border: 2px solid var(--color-border);
      border-radius: 50%;
      font-weight: 700;
      color: var(--color-text-muted);
      z-index: 1;
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .custom-form-container {
      background-color: var(--color-bg-card);
      padding: var(--spacing-2xl);
      border-radius: var(--radius-lg);
      border: 2px solid var(--color-primary);
      margin-top: var(--spacing-2xl);
      animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .form-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--spacing-xl);
      padding-bottom: var(--spacing-lg);
      border-bottom: 2px solid var(--color-border);
    }

    .form-header h3 {
      margin: 0;
      color: var(--color-primary);
    }

    .button-close {
      background: transparent;
      border: none;
      font-size: 2rem;
      color: var(--color-text-muted);
      cursor: pointer;
      line-height: 1;
      padding: 0;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: all 0.2s ease;
    }

    .button-close:hover {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--color-text-primary);
    }

    @media (max-width: 968px) {
      .plan-options-container {
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
      }

      .option-divider {
        height: auto;
      }

      .option-divider::before {
        display: none;
      }

      .option-divider span {
        width: 100%;
        border-radius: var(--radius-md);
      }

      .option-card p {
        min-height: auto;
      }
    }

    @media (max-width: 599px) {
      .option-card {
        padding: var(--spacing-xl);
      }

      .custom-form-container {
        padding: var(--spacing-lg);
      }

      .page-description {
        font-size: var(--font-size-base);
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const showFormBtn = document.getElementById('show-custom-form');
      const hideFormBtn = document.getElementById('hide-custom-form');
      const customFormContainer = document.getElementById('custom-plan-form');

      if (showFormBtn && customFormContainer) {
        showFormBtn.addEventListener('click', () => {
          customFormContainer.style.display = 'block';
          customFormContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      if (hideFormBtn && customFormContainer) {
        hideFormBtn.addEventListener('click', () => {
          customFormContainer.style.display = 'none';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    });
  </script>
</AppLayout>
