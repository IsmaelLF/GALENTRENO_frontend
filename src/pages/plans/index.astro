---
import AppLayout from "../../layouts/AppLayout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL || "https://galentreno-backend.onrender.com";
---

<AppLayout title="Plans Predefinidos">
  <h2>Plans Predefinidos</h2>
  <p>Explora as nosas rutinas creadas por expertos.</p>

  <div id="plans-list" class="plans-container">
    <p>Cargando plans...</p>
  </div>

  <style is:global></style>

  <script type="module" define:vars={{ apiUrl: apiUrl }}>
    document.addEventListener("DOMContentLoaded", async () => {
      const listaPlans = document.getElementById("plans-list");

      try {
        const response = await fetch(`${apiUrl}/api/plans/predefinidos`);
        if (!response.ok) throw new Error("Non se puideron cargar os plans");
        if (!listaPlans) return;
        const plans = await response.json();
        listaPlans.innerHTML = "";

        if (plans.length === 0) {
          listaPlans.innerHTML =
            "<p>Non hai plans predefinidos dispoñibles.</p>";
        } else {
          plans.forEach((plan) => {
            const card = document.createElement("a");
            card.className = "plan-card";
            card.href = `/plan/${plan.id}`;
            card.innerHTML = `
                            <h3>${plan.nome}</h3>
                            <p>${plan.descricion || "Sen descrición."}</p>
                        `;
            listaPlans.appendChild(card);
          });
        }
      } catch (error) {
        console.error("Error:", error);
        if (!listaPlans) return;
        listaPlans.innerHTML = "<p>Error ao cargar os plans.</p>";
      }
    });
  </script>
</AppLayout>
