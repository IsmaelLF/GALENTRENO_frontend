---
import Header from "../components/Header.astro";
const { title } = Astro.props;
---

<html lang="es" transition:animate="fade">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style is:global>
      @font-face {
        font-family: TexGyre;
        src: url("/fonts/texgyreheros-bold.otf") format("opentype");
      }

      * {
        font-family: TexGyre, sans-serif;
        font-weight: 400;
        box-sizing: border-box;
      }

      body {
        font-family: TexGyre, sans-serif;
        background-color: #111;
        margin: 0;
        color: #f0f0f0;
      }

      h1 {
        font-size: 2rem;
        font-weight: 600;
        text-align: center;
        color: #fff;
      }
      h2 {
        font-size: 1.2rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: #f0f0f0;
      }
      small {
        color: #f0f0f0;
        font-weight: 500;
      }

      .card {
        background-color: #1a1a1a;
        padding: 1rem;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        border: 1px solid #333;
        color: #f0f0f0;
      }
      .card strong {
        font-size: 1.5rem;
        display: block;
        margin-bottom: 0.25rem;
        color: #fff;
      }
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
      }

      .button {
        border: none;
        padding: 1em;
        margin: 1rem auto;
        width: 100%;
        background-color: #0d6efd;
        color: white;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        display: block;
        text-decoration: none;
        transition: background-color 0.2s ease;
      }

      .button:hover {
        background-color: #0b5ed7;
      }

      .button-register {
        background-color: #0d6efd;
        color: white;
        width: 20%;
      }

      .button-register:hover {
        background-color: #0b5ed7;
      }

      .button-login {
        background-color: #0d6efd;
        color: white;
        width: 20%;
      }

      .button-login:hover {
        background-color: #0b5ed7;
      }
      a {
        color: #ffffff;
        text-decoration: none;
      }

      .session-item {
        background-color: #1a1a1a;
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 0.75rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        border: 1px solid #333;
        color: #f0f0f0;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 0 auto;
        width: 40%;
      }
      .plans-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
      }
      .plan-card {
        background-color: #1a1a1a;
        color: white;
        padding: 1rem;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        border: 1px solid #333;
        text-decoration: none;
        display: block;
        transition:
          transform 0.2s ease,
          border-color 0.2s ease;
      }
      .plan-card:hover {
        transform: translateY(-2px);
        border-color: #0d6efd;
      }
      .plan-card h3 {
        margin-top: 0;
      }
      label {
        font-weight: 600;
        color: #f0f0f0;
        display: block;
        margin-bottom: 0.25rem;
      }

      input[type="text"],
      input[type="email"],
      input[type="password"],
      input[type="number"],
      select {
        width: 100%;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        border: 1px solid #555;
        background-color: #111;
        color: #ffffff;
        font-size: 1rem;
        font-family: inherit;
        box-sizing: border-box;
        transition:
          border-color 0.2s,
          box-shadow 0.2s;
      }

      input[type="text"]:focus,
      input[type="email"]:focus,
      input[type="password"]:focus,
      input[type="number"]:focus,
      select:focus {
        outline: none;
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.2);
      }
    </style></head
  >

  <body>
    <Header />

    <slot />
  </body>
</html>
