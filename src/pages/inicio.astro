---
import AppLayout from "../layouts/AppLayout.astro";
import { format } from "date-fns";
import { gl } from "date-fns/locale";

const diaActual = new Date();
const dataFormateada = format(diaActual, "EEEE, d 'de' MMMM 'de' yyyy", {
  locale: gl,
});
---

<AppLayout title="Inicio">
  <div class="dashboard-header">
    <div>
      <small id="current-date" data-data-formateada={dataFormateada}></small>
      <h1 id="user-greeting">Benvido a Galentreno</h1>
    </div>
    <a href="/meus-plans" class="button">Ver os Meus Plans →</a>
  </div>

  <section class="stats-section">
    <div class="stats-grid">
      <div class="card stat-card">
        <span class="stat-label">Adestramentos Totais</span>
        <strong id="total-trainings">--</strong>
      </div>
      <div class="card stat-card">
        <span class="stat-label">Volume Total</span>
        <strong id="total-volume">--</strong>
      </div>
      <div class="card stat-card">
        <span class="stat-label">Esta Semana</span>
        <strong id="week-trainings">--</strong>
      </div>
      <div class="card stat-card">
        <span class="stat-label">Último Peso</span>
        <strong id="last-weight">--</strong>
      </div>
    </div>
  </section>

  <section class="weight-section">
    <div class="weight-card">
      <div class="weight-info">
        <h2>Rexistro Rápido de Peso</h2>
        <p>Actualiza o teu peso corporal de hoxe para seguir a túa evolución.</p>
      </div>
      <div class="weight-controls">
        <div class="input-with-button">
          <input
            type="number"
            id="weight-input"
            placeholder="Ex: 75.5"
            step="0.1"
            min="0"
            max="400"
          />
          <button id="save-weight-btn" class="button">Gardar Peso</button>
        </div>
        <small id="weight-status" class="weight-status"></small>
      </div>
    </div>
  </section>

  <style>
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: var(--spacing-xl);
      padding-bottom: var(--spacing-lg);
      border-bottom: 1px solid var(--color-border);
    }

    .dashboard-header h1 {
      text-align: left;
      margin: 0.25rem 0 0 0;
    }

    .dashboard-header small {
      text-transform: capitalize;
      color: var(--color-primary);
      font-weight: 600;
    }

    .stats-section {
      margin-bottom: var(--spacing-2xl);
    }

    .stat-card {
      text-align: left;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 1.5rem;
    }

    .stat-label {
      font-size: var(--font-size-xs);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-text-muted);
      font-weight: 600;
    }

    .stat-card strong {
      font-size: 2rem;
      color: var(--color-text-primary);
      margin: 0;
    }

    .weight-card {
      background: var(--color-bg-card);
      backdrop-filter: blur(12px);
      padding: var(--spacing-xl);
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-border);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xl);
      align-items: center;
    }

    .weight-info h2 {
      margin: 0 0 0.35rem 0;
      font-size: var(--font-size-xl);
    }

    .weight-info p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .input-with-button {
      display: flex;
      gap: 0.75rem;
    }

    .input-with-button input {
      flex: 1;
    }

    .weight-status {
      display: block;
      margin-top: 0.5rem;
      min-height: 1.25em;
    }

    .weight-status.success {
      color: var(--color-success);
    }

    .weight-status.error {
      color: var(--color-danger);
    }

    @media (max-width: 768px) {
      .weight-card {
        grid-template-columns: 1fr;
        gap: var(--spacing-md);
      }

      .input-with-button {
        flex-direction: column;
      }
    }
  </style>

  <script src="../scripts/inicio.js"></script>
</AppLayout>