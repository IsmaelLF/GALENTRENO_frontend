---
const pathname = Astro.url.pathname;
---

<header>
  <nav>
    <a href="/inicio" class="logo" aria-label="Ir ao inicio">
      <span class="logo-dot"></span>
      <span>GALENTRENO</span>
    </a>

    <button
      class="mobile-menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <ul class="nav-links" id="nav-menu" role="navigation">
      <li>
        <a href="/inicio" class:list={[{ active: pathname === "/inicio" }]}>
          Inicio
        </a>
      </li>
      <li>
        <a href="/plans" class:list={[{ active: pathname === "/plans" }]}>
          Plans Predefinidos
        </a>
      </li>
      <li>
        <a
          href="/meus-plans"
          class:list={[{ active: pathname.startsWith("/meus-plans") }]}
        >
          Os Meus Plans
        </a>
      </li>
      <li>
        <a
          href="/plans/novo"
          class:list={[{ active: pathname === "/plans/novo" }]}
        >
          Crear Plan
        </a>
      </li>
      <li>
        <a href="#" id="logout-link" class="logout-btn">Pechar Sesión</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { supabase } from "../lib/supabase.js";

  const enlacePecharSesion = document.getElementById("logout-link");
  if (enlacePecharSesion) {
    enlacePecharSesion.addEventListener("click", async (evento) => {
      evento.preventDefault();
      await supabase.auth.signOut();
      window.location.href = "/";
    });
  }

  const botonMenuMovil = document.querySelector(".mobile-menu-toggle");
  const enlacesNav = document.querySelector(".nav-links");

  if (botonMenuMovil && enlacesNav) {
    enlacesNav.classList.remove("active");
    botonMenuMovil.classList.remove("active");
    botonMenuMovil.setAttribute("aria-expanded", "false");

    botonMenuMovil.addEventListener("click", () => {
      const estaExpandido =
        botonMenuMovil.getAttribute("aria-expanded") === "true";

      botonMenuMovil.setAttribute("aria-expanded", (!estaExpandido).toString());
      botonMenuMovil.classList.toggle("active");
      enlacesNav.classList.toggle("active");

      document.body.style.overflow = estaExpandido ? "" : "hidden";
    });

    document.addEventListener("click", (e) => {
      const obxectivo = e.target as HTMLElement;
      if (
        enlacesNav.classList.contains("active") &&
        !enlacesNav.contains(obxectivo) &&
        !botonMenuMovil.contains(obxectivo)
      ) {
        botonMenuMovil.setAttribute("aria-expanded", "false");
        botonMenuMovil.classList.remove("active");
        enlacesNav.classList.remove("active");
        document.body.style.overflow = "";
      }
    });

    const enlaces = enlacesNav.querySelectorAll("a");
    enlaces.forEach((enlace) => {
      enlace.addEventListener("click", () => {
        if (window.innerWidth < 768) {
          botonMenuMovil.setAttribute("aria-expanded", "false");
          botonMenuMovil.classList.remove("active");
          enlacesNav.classList.remove("active");
          document.body.style.overflow = "";
        }
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        botonMenuMovil.setAttribute("aria-expanded", "false");
        botonMenuMovil.classList.remove("active");
        enlacesNav.classList.remove("active");
        document.body.style.overflow = "";
      }
    });
  }
</script>

<style>
  header {
    background: #1f1d25;
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: 0.04em;
    z-index: 1001;
    transition: opacity var(--transition-base);
  }

  .logo:hover {
    opacity: 0.9;
    color: var(--color-text-primary);
  }

  .logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
    transition: border-color var(--transition-base);
  }

  .mobile-menu-toggle:hover {
    border-color: var(--color-border-hover);
  }

  .hamburger-line {
    width: 20px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-md);
    transition:
      color var(--transition-base),
      background-color var(--transition-base);
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  .nav-links a.active {
    color: var(--color-primary);
  }

  .nav-links a.logout-btn {
    color: var(--color-danger);
    border: 1px solid rgba(201, 77, 90, 0.18);
    margin-left: 0.5rem;
  }

  .nav-links a.logout-btn:hover {
    background-color: rgba(201, 77, 90, 0.08);
    border-color: rgba(201, 77, 90, 0.3);
    color: var(--color-danger);
  }

  @media (max-width: 767px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      height: 100dvh;
      width: 80%;
      max-width: 300px;
      background: #211f27;
      border-left: 1px solid var(--color-border);
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      gap: 0.75rem;
      box-shadow: -8px 0 24px rgba(33, 29, 43, 0.1);
      z-index: 1000;
      padding: 2rem 1.25rem;
      visibility: hidden;
      opacity: 0;
      transition: right 0.3s ease, opacity 0.3s ease, visibility 0s 0.3s;
    }

    .nav-links.active {
      right: 0;
      visibility: visible;
      opacity: 1;
      transition: right 0.3s ease, opacity 0.3s ease;
    }

    .nav-links a {
      font-size: 1rem;
      padding: 0.875rem 1rem;
      display: block;
      text-align: left;
    }

    .nav-links a.logout-btn {
      margin-left: 0;
      margin-top: 1rem;
      text-align: center;
    }
  }
</style>